# .env.sample 을 복사해 .env 를 만들고 값을 채웁니다. .env 는 커밋하지 않습니다.
DATABASE_URL=
# (선택) 서버가 쓸 DB 연결 수. 비우면 3 (공용 DB는 계정당 5개까지라 넘기지 않기)
DB_POOL_MAX=
OPENROUTER_API_KEY=
# (선택) AI 상담 모델. 비우면 무료 모델 4개를 차례로 시도. 예: CHAT_MODEL=google/gemma-4-26b-a4b-it:free
CHAT_MODEL=
# 관리자 로그인 쿠키 서명용 임의 문자열 (32자 이상). 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# 백엔드 앞에 있는 프록시 수. 비우면 개발은 1(Vite), 배포 모드(npm start)는 0. 배포 때 앞에 nginx·호스팅 프록시가 있으면 1
# (프록시가 없는데 1로 두면 손님이 보낸 X-Forwarded-For 를 믿어서 횟수 제한·관리자 IP 제한을 피할 수 있다)
TRUST_PROXY_HOPS=
# 화면 서버(Vite)만 아는 비밀 값. 백엔드는 이 값이 붙은 요청만 받는다 (공유 서버에서 직접 접속 막기). 예: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PROXY_SECRET=
# 하루 전체 AI 호출 상한 (모든 손님 합계, 비우면 40)
AI_DAILY_LIMIT=
# 한 사람(비회원은 IP, 회원은 계정)이 하루에 할 수 있는 AI 질문 수. 비우면 운영은 전체 상한의 1/10, 개발은 따로 두지 않음
AI_DAILY_PER_USER=
# 토스페이먼츠 결제위젯 연동 키 (개발자센터 → API 키). 비우면 개발용 테스트 결제로 동작
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 개인정보·2단계 인증 비밀값을 암호화하는 키, 64자리 16진수. 잃어버리면 저장된 개인정보를 읽을 수 없으니 DB 백업과 따로 보관. 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_KEY=
# 관리자 접속 허용 IP (쉼표로 여러 개, 끝이 점이면 대역). 비우면 제한 없음. 예: 203.0.113.10,198.51.100.
ADMIN_ALLOWED_IPS=
# 2단계 인증 필수 여부. 운영(NODE_ENV=production)에서는 비워 둬도 켜진다. 끄려면 0
# 운영에서 테스트 결제 키로 주문을 받으려면(오픈 전 리허설만) ALLOW_TEST_PAYMENTS=1
REQUIRE_2FA=
# 이메일 알림 (비우면 보내지 않고 관리자 [알림 기록]에만 남김). 예: 회사 메일·Gmail 앱 비밀번호·메일 발송 서비스
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# 새 주문·문의 알림을 받을 관리자 이메일
ADMIN_EMAIL=
# 몰 주소 (배포 후 https://도메인). 메일 속 링크, sitemap.xml, 공유 미리보기에 쓰인다
PUBLIC_URL=
# (선택) 카카오·네이버 간편 로그인 (손님 회원). 비우면 버튼이 숨겨진다.
# 키 없이 개발에서 [시험 로그인](모두 같은 가짜 회원)을 쓰려면 OAUTH_MOCK=1 (운영 NODE_ENV=production 에서는 적어도 꺼짐. 공개 서버에는 적지 않기)
OAUTH_MOCK=
# 각 개발자 센터에 돌아올 주소를 PUBLIC_URL/api/account/oauth/kakao/callback (네이버는 /naver/callback) 로 등록한다
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
