# .env.sample 을 복사해 .env 를 만들고 값을 채웁니다. .env 는 커밋하지 않습니다.
DATABASE_URL=
OPENROUTER_API_KEY=
# (선택) AI 상담 모델. 비우면 무료 모델 4개를 차례로 시도. 예: CHAT_MODEL=google/gemma-4-26b-a4b-it:free
CHAT_MODEL=
# 관리자 로그인 쿠키 서명용 임의 문자열 (32자 이상). 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# 백엔드 앞에 있는 프록시 수 (개발: Vite 1). 배포 시 웹 서버를 하나 더 두면 2
TRUST_PROXY_HOPS=
# 화면 서버(Vite)만 아는 비밀 값. 백엔드는 이 값이 붙은 요청만 받는다 (공유 서버에서 직접 접속 막기). 예: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PROXY_SECRET=
# 하루 전체 AI 호출 상한 (모든 손님 합계, 비우면 40)
AI_DAILY_LIMIT=
# 토스페이먼츠 결제위젯 연동 키 (개발자센터 → API 키). 비우면 개발용 테스트 결제로 동작
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 저장할 때 암호화하는 값(2단계 인증 비밀값 등)의 키, 64자리 16진수. 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" — 바꾸면 등록한 2단계 인증을 다시 해야 함
DATA_KEY=
# 관리자 접속 허용 IP (쉼표로 여러 개, 끝이 점이면 대역). 비우면 제한 없음. 예: 203.0.113.10,198.51.100.
ADMIN_ALLOWED_IPS=
# 1이면 2단계 인증을 등록하지 않은 계정은 로그인 불가 (운영에서 켜기)
REQUIRE_2FA=
