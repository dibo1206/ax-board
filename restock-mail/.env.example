# 이 파일을 .env 로 복사해서 사용하세요:  cp .env.example .env

# ── 서버 ──
PORT=3065
# 127.0.0.1 = 이 컴퓨터에서만 접속 가능 / 0.0.0.0 = 외부에서도 접속 가능
HOST=127.0.0.1
# 메일 속 링크(구매하기, 신청 취소)에 들어가는 주소. 실서비스 도메인으로 바꾸세요.
BASE_URL=http://localhost:3065

# ── 메일 (SMTP) ──
# 아래 SMTP_ 항목을 비워두면 Ethereal 테스트 메일함으로 발송됩니다 (실제 배달 X, 미리보기 링크로 확인).
# Gmail 사용 시: 구글 계정 > 보안 > 2단계 인증 켜기 > "앱 비밀번호" 발급 후 SMTP_PASS 에 입력
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="재입고 알림 <no-reply@example.com>"
