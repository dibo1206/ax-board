// GitHub Codespaces(깃허브 안의 클라우드 개발 컴퓨터)로 설치 없이 바로 실행하기
// 저장소 → Code → Codespaces → Create codespace on main → 2~3분 뒤 브라우저에 쇼핑몰이 열린다
// 1) 처음 만들 때: 라이브러리 설치 → .env 자동 생성 → 예시 데이터 넣기
// 2) 켜질 때마다: 화면 + 백엔드를 뒤에서 실행 (편집기 창·터미널을 닫아도 계속 켜져 있음. 기록은 /tmp/farm-mall-demo.log)
// 3) 편집기 창이 붙을 때마다: 쇼핑몰 주소와 여는 방법 안내 (팝업 차단이면 [포트] 탭 → 3066 → 지구본 아이콘)
{
  "name": "YOONJU MARKET (farm-mall)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  // gh codespace ssh·logs 로 터미널에서 접속할 수 있게
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "forwardPorts": [3066],
  "portsAttributes": {
    "3066": { "label": "쇼핑몰 화면", "onAutoForward": "openBrowser" },
    "3166": { "label": "백엔드 (직접 열지 않아도 됨)", "onAutoForward": "silent" }
  },
  "postCreateCommand": "npm ci && npm run setup && npm run load-data",
  "postStartCommand": "setsid nohup npm run demo > /tmp/farm-mall-demo.log 2>&1 < /dev/null &",
  "postAttachCommand": "node scripts/codespace-hint.js",
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
